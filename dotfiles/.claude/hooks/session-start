#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

machine_context_content=$("${PLUGIN_ROOT}/skills/machine-context/generate.sh" 2>&1 || echo "Error generating machine-context skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

machine_context_escaped=$(escape_for_json "$machine_context_content")
session_context="<EXTREMELY_IMPORTANT>\n\n**Below is the full content of your 'machine-context' skill - it tells you about the machine you're on:**\n\n${machine_context_escaped}\n</EXTREMELY_IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"